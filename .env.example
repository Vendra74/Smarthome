# Copie para .env (que fica fora do git) e preencha. Nunca faça commit do .env.

# Chave da API da Anthropic, usada pelo agente de voz/texto.
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: token pessoal do SmartThings (https://account.smartthings.com/tokens)
SMARTTHINGS_TOKEN=

# Opcional: token pessoal do LG ThinQ (https://connect-pat.lgthinq.com)
LG_THINQ_TOKEN=

# Opcional: projeto Tuya para os aparelhos do Izy Smart (Intelbras), Smart Life ou Tuya Smart
# Crie em https://iot.tuya.com (Cloud > Development > Create Cloud Project) e vincule a conta do app
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Opcional: qual casa carregar e onde ficam os dados
# SMARTHOME_HOME=casa
# SMARTHOME_DATA=data
