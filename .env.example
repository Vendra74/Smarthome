# Copie para .env (que fica fora do git) e preencha. Nunca faça commit do .env.

# Chave da API da Anthropic, usada pelo agente de voz/texto.
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Login por conta (tela "Contas" do app): quem publica a central registra uma SmartApp
# na SmartThings uma vez (ver README, "Contas") e põe aqui o client id e o secret dela.
# O usuário final nunca mexe nisso: só clica em "Conectar" e entra com a conta Samsung.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# Endereço pelo qual o navegador chega à central (o retorno do login da Samsung volta para cá)
# SMARTHOME_PUBLIC_URL=http://localhost:8000

# Alternativa para desenvolvimento: token pessoal do SmartThings (https://account.smartthings.com/tokens)
SMARTTHINGS_TOKEN=

# Opcional: token pessoal do LG ThinQ (https://connect-pat.lgthinq.com); também dá para colar em "Contas"
LG_THINQ_TOKEN=

# Opcional, só para desenvolvimento: projeto Tuya em https://iot.tuya.com. O usuário final
# conecta o Smart Life por QR code em "Contas", sem nada disso.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Opcional: qual casa carregar e onde ficam os dados
# SMARTHOME_HOME=casa
# SMARTHOME_DATA=data
